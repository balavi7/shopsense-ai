# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is in .gitignore — never commit it

aws_region       = "ap-south-1"
project_name     = "shopsense-ai"
environment      = "production"
instance_type    = "t3.medium"
key_pair_name    = "your-key-pair-name"    # ← replace with your AWS key pair name
allowed_ssh_cidr = "0.0.0.0/0"            # ← replace with your IP: "x.x.x.x/32"# Copy this file to terraform.tfvars and fill in your values
